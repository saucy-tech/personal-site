{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-site",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Free-plan worker budget is 3 MiB gzipped; minify keeps us under it.
  "minify": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "saucy.tech", "custom_domain": true },
    { "pattern": "www.saucy.tech", "custom_domain": true }
  ],
  // Keep the workers.dev preview alive alongside the custom domains.
  "workers_dev": true,
  "preview_urls": true,
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "personal-site"
    }
  ]
}

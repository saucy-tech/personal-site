{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-site",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Free-plan worker budget is 3 MiB gzipped; minify keeps us under it.
  "minify": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "saucy.tech", "custom_domain": true },
    { "pattern": "www.saucy.tech", "custom_domain": true }
  ],
  // Keep the production workers.dev alias off; production uses saucy.tech.
  // Public version/branch previews are intentional for PR review. They use
  // this Worker's bindings and runtime rate limits, not saucy.tech zone rules.
  // Bound per-invocation CPU with headroom above the measured 30-day p99.
  "limits": { "cpu_ms": 5000 },
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": false }
  },
  "preview_urls": true,

  // One atomic counter per tier, evaluated by the runtime. Without these the
  // limiter falls back to a per-isolate Map, which is not a limit at all — see
  // rateLimitWithBinding in src/utils/security.ts. The limits here must match
  // SECURITY_CONSTANTS; the mapping in that file is keyed on them.
  // namespace_id is a local identifier, not a resource to provision.
  "ratelimits": [
    { "name": "RATE_LIMITER_SUBSCRIBE", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "RATE_LIMITER_INVOICE", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    { "name": "RATE_LIMITER_API", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "personal-site"
    }
  ]
}

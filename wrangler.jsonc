{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-site",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Free-plan worker budget is 3 MiB gzipped; minify keeps us under it.
  "minify": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "saucy.tech", "custom_domain": true },
    { "pattern": "www.saucy.tech", "custom_domain": true }
  ],
  // Both off. A *.workers.dev hostname serves this identical Worker — including
  // every anonymous /api/ route — but sits outside the saucy.tech zone, so no
  // WAF rule, rate-limiting rule or bot-management setting scoped to that zone
  // applies to it. It is also the obvious way around any limit added at the
  // zone edge. Use `wrangler dev` or a preview deployment for the preview need.
  "workers_dev": false,
  "preview_urls": false,

  // Rate-limit counters, shared across every isolate and colo. Without this the
  // limiter falls back to a per-isolate Map, which is not a limit — see
  // rateLimitWithKV in src/utils/security.ts.
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      "id": "REPLACE_WITH_NAMESPACE_ID"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "personal-site"
    }
  ]
}

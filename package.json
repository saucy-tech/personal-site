{
  "name": "personal-site",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "WATCHPACK_POLLING=true next dev",
    "build": "next build",
    "start": "next start",
    "analyze": "ANALYZE=true next build",
    "check": "pnpm lint && pnpm exec tsc --noEmit && pnpm test",
    "lint": "eslint src scripts",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:watch": "jest --watch",
    "prepare": "husky",
    "broadcast": "ts-node --project tsconfig.scripts.json scripts/auto-broadcast.ts",
    "content:validate": "ts-node --project tsconfig.scripts.json scripts/validate-content.ts",
    "content:check-links": "ts-node --project tsconfig.scripts.json scripts/check-internal-links.ts",
    "content:check-images": "ts-node --project tsconfig.scripts.json scripts/check-image-hygiene.ts",
    "security:drift": "ts-node -r tsconfig-paths/register --project tsconfig.scripts.json scripts/check-security-drift.ts",
    "quality:gate": "pnpm lint && pnpm test && pnpm content:validate && pnpm content:check-links && pnpm content:check-images && pnpm security:drift",
    "docs:architecture": "ts-node --project tsconfig.scripts.json scripts/generate-architecture-docs.ts"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@getalby/sdk": "^7.0.0",
    "@heroicons/react": "^2.1.1",
    "@sentry/nextjs": "^10.27.0",
    "@tailwindcss/typography": "^0.5.13",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "github-slugger": "^1.5.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.1",
    "next": "^16.2.4",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.2.5",
    "react-confetti": "^6.4.0",
    "react-dom": "^19.2.5",
    "react-qr-code": "^2.0.15",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^2.6.0",
    "ws": "^8.20.0"
  },
  "pnpm": {
    "allowScripts": {
      "sharp": true,
      "unrs-resolver": true
    },
    "overrides": {
      "@isaacs/brace-expansion@<=5.0.0": ">=5.0.1",
      "brace-expansion": "5.0.5",
      "glob@>=10.2.0 <10.5.0": ">=10.5.0",
      "js-yaml@<3.14.2": ">=3.14.2",
      "js-yaml@>=4.0.0 <4.1.1": ">=4.1.1",
      "mdast-util-to-hast@>=13.0.0 <13.2.1": ">=13.2.1",
      "minimatch@>=9.0.0 <10.0.0": ">=10.2.1",
      "minimatch@>=3.0.0 <3.1.4": ">=3.1.4",
      "picomatch": "4.0.4",
      "yaml@>=2.0.0 <2.8.3": ">=2.8.3",
      "ajv@>=6.0.0 <6.14.0": ">=6.14.0",
      "flatted@<3.4.0": "3.4.2"
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@next/bundle-analyzer": "^16.2.4",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.29.0",
    "eslint-config-next": "^16.2.4",
    "eslint-config-prettier": "^10.1.1",
    "eslint-import-resolver-typescript": "^4.3.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.6",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.10",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "zod": "^4.3.6"
  }
}

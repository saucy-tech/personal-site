{
  "name": "personal-site",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "gen:posts": "ts-node --project tsconfig.scripts.json scripts/generate-posts-data.ts",
    "dev": "pnpm gen:posts && WATCHPACK_POLLING=true next dev",
    "build": "pnpm gen:posts && next build",
    "start": "next start",
    "analyze": "pnpm gen:posts && ANALYZE=true next build",
    "check": "pnpm lint && pnpm exec tsc --noEmit && pnpm test",
    "lint": "eslint src scripts",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:watch": "jest --watch",
    "prepare": "husky",
    "broadcast": "ts-node --project tsconfig.scripts.json scripts/auto-broadcast.ts",
    "content:validate": "ts-node --project tsconfig.scripts.json scripts/validate-content.ts",
    "content:check-links": "ts-node --project tsconfig.scripts.json scripts/check-internal-links.ts",
    "content:check-images": "ts-node --project tsconfig.scripts.json scripts/check-image-hygiene.ts",
    "security:drift": "ts-node -r tsconfig-paths/register --project tsconfig.scripts.json scripts/check-security-drift.ts",
    "quality:gate": "pnpm lint && pnpm test && pnpm content:validate && pnpm content:check-links && pnpm content:check-images && pnpm security:drift",
    "preview": "pnpm gen:posts && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "build:worker": "pnpm gen:posts && opennextjs-cloudflare build && node scripts/cf-slim-og.mjs",
    "deploy": "pnpm run build:worker && opennextjs-cloudflare deploy -- --keep-vars",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@getalby/sdk": "^7.0.0",
    "@heroicons/react": "^2.1.1",
    "@opennextjs/cloudflare": "^1.20.2",
    "@sentry/nextjs": "^10.69.0",
    "@tailwindcss/typography": "^0.5.20",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.2.3",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-confetti": "^6.4.0",
    "react-dom": "^19.2.8",
    "react-qr-code": "^2.2.0",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.21.1"
  },
  "pnpm": {
    "allowScripts": {
      "sharp": true,
      "unrs-resolver": true
    },
    "overrides": {
      "@isaacs/brace-expansion@<=5.0.0": ">=5.0.1",
      "glob@>=10.2.0 <10.5.0": ">=10.5.0",
      "js-yaml@<3.14.2": ">=3.14.2",
      "js-yaml@>=4.0.0 <4.1.1": ">=4.1.1",
      "gray-matter>js-yaml": "^4.2.0",
      "mdast-util-to-hast@>=13.0.0 <13.2.1": ">=13.2.1",
      "minimatch@>=9.0.0 <10.0.0": ">=10.2.1",
      "minimatch@>=3.0.0 <3.1.4": ">=3.1.4",
      "picomatch": "4.0.4",
      "yaml@>=2.0.0 <2.8.3": ">=2.8.3",
      "ajv@>=6.0.0 <6.14.0": ">=6.14.0",
      "flatted@<3.4.0": "3.4.2",
      "postcss@<8.5.10": ">=8.5.10",
      "brace-expansion@1": "^1.1.17",
      "brace-expansion@2": "^2.1.3",
      "brace-expansion@3": "^3.0.1",
      "brace-expansion@4": "^4.0.1",
      "brace-expansion@5": "^5.0.9",
      "form-data@>=4.0.0 <4.0.6": ">=4.0.6",
      "ws@>=8.0.0 <8.21.0": ">=8.21.0",
      "undici@>=7.0.0 <7.29.0": ">=7.29.0 <8",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "@opentelemetry/core@<2.8.0": ">=2.8.0",
      "sharp@<0.35.0": ">=0.35.0"
    }
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.12",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^9.29.0",
    "eslint-config-next": "^16.2.12",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "unified": "^11.0.5",
    "wrangler": "^4.118.0",
    "zod": "^4.4.3"
  }
}

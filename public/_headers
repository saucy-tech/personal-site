/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# Pre-sized image variants. Each file name carries a hash of its content
# (scripts/generate-image-variants.mjs), so the URL changes when the image does.
/optimized/*
  Cache-Control: public,max-age=31536000,immutable

# Stable, unversioned URLs: cache for a day, never immutable.
/headshot.jpeg
  Cache-Control: public,max-age=86400
/favicon.ico
  Cache-Control: public,max-age=86400
/apple-touch-icon.png
  Cache-Control: public,max-age=86400
/bitcoin-journey.png
  Cache-Control: public,max-age=86400
/icons/*
  Cache-Control: public,max-age=86400
/images/*
  Cache-Control: public,max-age=86400

# =============================================================================
# ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env.local and fill in your actual values

# =============================================================================
# REQUIRED - Lightning Network Integration
# =============================================================================

# Nostr Wallet Connect URL for Lightning payments
# Get this from your Lightning wallet that supports NWC (e.g., Alby, Mutiny, etc.)
NOSTR_WALLET_CONNECT_URL=

# =============================================================================
# OPTIONAL - Application Configuration
# =============================================================================

# Drives all public-facing URLs: OG metadata, canonical links, sitemap, RSS, JSON-LD
# Set this on preview/staging deployments to avoid metadata pointing to production
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Canonical site URL (preferred over NEXT_PUBLIC_APP_URL for metadata when set)
SITE_URL=https://your-domain.com

# Send CSP violation reports to /api/csp-report (append report-uri directive)
# ENABLE_CSP_VIOLATION_REPORTS=1

# Emit the same CSP as Content-Security-Policy-Report-Only for soak testing
# CSP_REPORT_ONLY=1

# =============================================================================
# OPTIONAL - LNURL-p Configuration
# =============================================================================

# Minimum sendable amount in millisatoshis (default: 1000 = 1 sat)
LNURL_MIN_SENDABLE=1000

# Maximum sendable amount in millisatoshis (default: 1000000000 = 1M sats)
LNURL_MAX_SENDABLE=1000000000

# Maximum characters allowed in tip comments (default: 280)
LNURL_COMMENT_ALLOWED=280

# Metadata text for LNURL-p payments
LNURL_METADATA_TEXT="Tip to brandon"

# Metadata description for LNURL-p payments
LNURL_METADATA_DESC="Lightning tip jar for brandon"

# =============================================================================
# OPTIONAL - Email Newsletter Integration
# =============================================================================

# Kit (ConvertKit) configuration for email subscriptions (subscribe form)
# CONVERTKIT_API_KEY is a Kit v4 API key (kit_…) from Settings → Developer
CONVERTKIT_API_KEY=
CONVERTKIT_FORM_ID=

# ConvertKit v4 API configuration for auto-broadcast script (pnpm broadcast)
# CK_SECRET_KEY  – your ConvertKit secret API key (Settings → Advanced → API Secret)
# CK_PUBLISHER_ID – numeric publisher/account ID (Settings → Advanced)
CK_SECRET_KEY=
CK_PUBLISHER_ID=

# =============================================================================
# DEVELOPMENT - Additional Configuration
# =============================================================================

# Set to true to enable debug logging in development
DEBUG=false

# Error monitoring (optional — enables Sentry in src/instrumentation.ts)
# SENTRY_DSN=
# GOOGLE_ANALYTICS_ID=
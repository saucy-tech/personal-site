# =============================================================================
# ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env.local and fill in your actual values

# =============================================================================
# REQUIRED - Lightning Network Integration
# =============================================================================

# Nostr Wallet Connect URL for Lightning payments
# Get this from your Lightning wallet that supports NWC (e.g., Alby, Mutiny, etc.)
NOSTR_WALLET_CONNECT_URL=

# =============================================================================
# OPTIONAL - Application Configuration
# =============================================================================

# App URL for OpenGraph metadata and absolute URLs
NEXT_PUBLIC_APP_URL=https://your-domain.com

# =============================================================================
# OPTIONAL - LNURL-p Configuration
# =============================================================================

# Minimum sendable amount in millisatoshis (default: 1000 = 1 sat)
LNURL_MIN_SENDABLE=1000

# Maximum sendable amount in millisatoshis (default: 1000000000 = 1M sats)
LNURL_MAX_SENDABLE=1000000000

# Maximum characters allowed in tip comments (default: 280)
LNURL_COMMENT_ALLOWED=280

# Metadata text for LNURL-p payments
LNURL_METADATA_TEXT="Tip to brandon"

# Metadata description for LNURL-p payments
LNURL_METADATA_DESC="Lightning tip jar for brandon"

# =============================================================================
# OPTIONAL - Email Newsletter Integration
# =============================================================================

# ConvertKit API configuration for email subscriptions
CONVERTKIT_API_KEY=
CONVERTKIT_FORM_ID=

# =============================================================================
# DEVELOPMENT - Additional Configuration
# =============================================================================

# Set to true to enable debug logging in development
DEBUG=false

# Analytics or monitoring service keys (if using)
# SENTRY_DSN=
# GOOGLE_ANALYTICS_ID=